{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synaplex.ai/discovery-framework/0.2.0/common.schema.json",
  "title": "Discovery Framework — Common Types",
  "description": "Shared type definitions. Spec version 0.2.0.",
  "$defs": {
    "SpecVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Duration": {
      "type": "string",
      "description": "ISO-8601 duration",
      "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(\\d+H)?(\\d+M)?(\\d+(\\.\\d+)?S)?)?$"
    },
    "LayerId": {
      "type": "string",
      "enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6", "L7"]
    },
    "PrincipalId": {
      "type": "string",
      "description": "Stable id: 'human:<name>' or '<layer>:<instance>'",
      "pattern": "^(human:[a-z0-9_-]+|L[0-7]:[a-z0-9_-]+)$"
    },
    "Binding": {
      "type": "string",
      "enum": ["advisory", "binding"]
    },
    "ConsumerPath": {
      "type": "string",
      "enum": [
        "trigger_gate",
        "ranking",
        "routing",
        "sampling",
        "budget_allocation",
        "automated_decision",
        "human_review",
        "audit_only"
      ]
    },
    "AutomatedConsumerPath": {
      "type": "string",
      "enum": [
        "trigger_gate",
        "ranking",
        "routing",
        "sampling",
        "budget_allocation",
        "automated_decision"
      ]
    },
    "ViolationKind": {
      "type": "string",
      "enum": [
        "advisory_leak",
        "constitutional_policy_amendment_attempt",
        "retrospective_role_relabel",
        "ceiling_breach",
        "external_validation_unmet",
        "novel_primitive_review_unmet",
        "missing_required_field",
        "schema_validation_failure",
        "backdated_role_declaration",
        "candidate_set_inconsistency",
        "rollback_precedence_invalid",
        "policy_reference_unresolved",
        "evidence_claim_mismatch",
        "frozen_policy_amendment_attempt",
        "frozen_policy_late_issuance",
        "frozen_policy_duplicate",
        "frozen_policy_scope_violation",
        "frozen_policy_citation_incomplete",
        "frozen_policy_derivation_mismatch",
        "frozen_policy_evidence_unanchored",
        "frozen_policy_constitutional_collision",
        "other"
      ],
      "description": "v0.2.0 added policy_reference_unresolved (validator rule 5 had no violation kind in v0.1.0), evidence_claim_mismatch (rule 15), and the frozen_policy_* kinds (rules 9-14, 16, 17). Refusal reasons are machine-readable by design: a refused write whose cause collapses to 'other' is not auditable."
    },
    "Role": {
      "type": "string",
      "enum": ["Claim", "Evidence", "Decision", "Promotion", "Realization", "Policy", "EventLogEntry"]
    },
    "Exposure": {
      "type": "object",
      "required": [
        "capital_at_risk",
        "reversibility",
        "correlation_tags",
        "time_to_realization",
        "blast_radius"
      ],
      "additionalProperties": false,
      "properties": {
        "capital_at_risk": { "type": "number", "minimum": 0 },
        "reversibility": {
          "type": "string",
          "enum": ["reversible", "partially_reversible", "irreversible"]
        },
        "correlation_tags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "time_to_realization": { "$ref": "#/$defs/Duration" },
        "blast_radius": {
          "type": "string",
          "enum": ["local", "instance", "cross-instance", "framework"]
        }
      }
    },
    "SourceRef": {
      "type": "object",
      "description": "Citation of an upstream canon object used as input to this emission. The consumer_path + automation + activation_capability_id fields are load-bearing for the influence-firewall check in control-plane.md §4.2.",
      "required": ["object_type", "id", "binding", "source_layer", "consumer_path", "automation"],
      "additionalProperties": false,
      "properties": {
        "object_type": { "$ref": "#/$defs/Role" },
        "id": { "type": "string" },
        "binding": { "$ref": "#/$defs/Binding" },
        "source_layer": { "$ref": "#/$defs/LayerId" },
        "source_output_type": {
          "type": "string",
          "description": "Emitter-declared output type of the source layer (e.g., 'risk_aggregate', 'regime_classification'). Used with activation_capability_id to match an activated capability."
        },
        "consumer_path": {
          "$ref": "#/$defs/ConsumerPath",
          "description": "How this source influenced the emission. Closed enum (see ConsumerPath). Automated paths and non-automated paths are partitioned; automation cannot be misdeclared without contradicting consumer_path."
        },
        "automation": {
          "type": "boolean",
          "description": "True if the consumer path is automated. The allOf block below couples this to consumer_path: paths in the automated set REQUIRE automation=true; paths in the non-automated set REQUIRE automation=false. This prevents the 'ranking with automation=false' spoof."
        },
        "activation_capability_id": {
          "type": "string",
          "description": "Required when binding='advisory' AND automation=true. References a preregistered activation-capability Policy that flips this source_output_type to binding for this consumer."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "consumer_path": {
                "enum": ["trigger_gate", "ranking", "routing", "sampling", "budget_allocation", "automated_decision"]
              }
            },
            "required": ["consumer_path"]
          },
          "then": { "properties": { "automation": { "const": true } } }
        },
        {
          "if": {
            "properties": {
              "consumer_path": { "enum": ["human_review", "audit_only"] }
            },
            "required": ["consumer_path"]
          },
          "then": { "properties": { "automation": { "const": false } } }
        },
        {
          "if": {
            "properties": {
              "binding": { "const": "advisory" },
              "automation": { "const": true }
            },
            "required": ["binding", "automation"]
          },
          "then": { "required": ["activation_capability_id", "source_output_type"] }
        }
      ]
    },
    "ArtifactPointer": {
      "type": "object",
      "required": ["uri", "content_hash", "version"],
      "additionalProperties": false,
      "properties": {
        "uri": { "type": "string", "format": "uri-reference" },
        "content_hash": {
          "type": "string",
          "description": "Hash of the referenced artifact content (e.g., sha256:...)",
          "pattern": "^[a-z0-9]+:[a-f0-9]+$"
        },
        "version": { "type": "string", "minLength": 1 },
        "anchor": { "type": "string", "description": "Optional selector (line range, heading, json-pointer)" },
        "media_type": { "type": "string" }
      }
    },
    "EnvelopeBase": {
      "type": "object",
      "required": [
        "id",
        "spec_version",
        "object_type",
        "emitted_at",
        "emitter",
        "layer",
        "roles",
        "role_declared_at",
        "binding",
        "sources"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "spec_version": { "$ref": "#/$defs/SpecVersion" },
        "object_type": { "$ref": "#/$defs/Role" },
        "emitted_at": { "$ref": "#/$defs/Timestamp" },
        "emitter": { "$ref": "#/$defs/PrincipalId" },
        "layer": { "$ref": "#/$defs/LayerId" },
        "roles": {
          "type": "array",
          "items": { "$ref": "#/$defs/Role" },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Declared role set. Immutable post-emission."
        },
        "role_declared_at": {
          "$ref": "#/$defs/Timestamp",
          "description": "Timestamp at which the role set was first declared. MUST be ≤ emitted_at. Triggers that count role-tagged events use role_declared_at, not emitted_at."
        },
        "binding": {
          "$ref": "#/$defs/Binding",
          "description": "Non-activated meta-layer outputs MUST declare 'advisory'."
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/SourceRef" },
          "description": "Empty array is valid (no upstream canon citations). The array itself is required — omission is not. This is what makes the influence firewall mechanically checkable."
        }
      }
    }
  }
}
